{
  "kind": "singleType",
  "collectionName": "site_settings",
  "info": {
    "singularName": "site-setting",
    "pluralName": "site-settings",
    "displayName": "Site settings",
    "description": "Editable brand name and header menu links"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "brandName": {
      "type": "string",
      "default": "Kana Mud Resort"
    },
    "menuLinks": {
      "type": "json"
    },
    "roomSortOrder": {
      "type": "enumeration",
      "enum": ["default", "price-low-high", "price-high-low"],
      "default": "default"
    }
  }
}
