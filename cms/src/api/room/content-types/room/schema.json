{
  "kind": "collectionType",
  "collectionName": "rooms",
  "info": {
    "singularName": "room",
    "pluralName": "rooms",
    "displayName": "Room",
    "description": "Accommodation types and details"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "shortDescription": {
      "type": "text"
    },
    "description": {
      "type": "richtext"
    },
    "priceLabel": {
      "type": "string",
      "default": "From ₹0 / night"
    },
    "originalPrice": {
      "type": "integer",
      "min": 0
    },
    "discountedPrice": {
      "type": "integer",
      "min": 0
    },
    "capacity": {
      "type": "integer",
      "min": 1,
      "default": 2
    },
    "sortOrder": {
      "type": "integer",
      "default": 0
    },
    "featuredImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "gallery": {
      "type": "media",
      "multiple": true,
      "allowedTypes": ["images"]
    }
  }
}
